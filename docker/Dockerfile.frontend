# LeetCoach AI — dashboard image (multi-stage)
FROM node:20-alpine AS build
# VITE_API_URL is inlined at build time. Default /api/v1 works behind the
# docker-compose nginx proxy; set the absolute backend URL when deploying
# standalone (e.g. Railway/Render).
ARG VITE_API_URL=/api/v1
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend .
# The dashboard aliases @leetcoach/shared -> ../extension/src/shared (vite.config.ts).
COPY extension/src/shared /extension/src/shared
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine
# NGINX_CONF selects the server config: nginx.conf (compose, proxied API) or
# nginx.railway.conf (standalone, SPA fallback, listens on $PORT).
ARG NGINX_CONF=nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/${NGINX_CONF} /etc/nginx/templates/default.conf.template
ENV PORT=80
EXPOSE 80
