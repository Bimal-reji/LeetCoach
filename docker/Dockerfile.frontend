# LeetCoach AI — dashboard image (multi-stage)
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend .
# The dashboard aliases @leetcoach/shared -> ../extension/src/shared (vite.config.ts).
COPY extension/src/shared /extension/src/shared
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
